  "keywords": [
    "node-red",
    "node-red-dashboard-2",
    "flowfuse",
    "flowfuse-dashboard",
    "dashboard",
    "dashboard-2",
    "ui",
    "widget",
    "floating-action-button",
    "fab",
    "speed-dial",
    "speeddial",
    "action-button",
    "action-menu",
    "quick-actions",
