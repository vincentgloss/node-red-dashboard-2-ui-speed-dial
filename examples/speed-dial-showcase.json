  {
    "id": "sdshow32fn",
    "type": "function",
    "z": "sdshow01tab",
    "name": "Count alerts",
    "func": "// Keep the number in the flow context and show it on the button.\nconst alerts = (flow.get('alerts') || 0) + 1;\nflow.set('alerts', alerts);\nnode.status({ text: alerts + ' alert(s)' });\nreturn { payload: { button: { badge: alerts } } };\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 220,
    "wires": [
      [
        "sdshow33dial"
      ]
    ]
  },
