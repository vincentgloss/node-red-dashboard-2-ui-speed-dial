  {
    "id": "sdshow34fn",
    "type": "function",
    "z": "sdshow01tab",
    "name": "Clear counter",
    "func": "// A click on \"Clear counter\" resets the count and hides the badge (0 hides it).\nif (msg.action !== 'clear-alerts') return null;\nflow.set('alerts', 0);\nreturn { payload: { button: { badge: 0 } } };\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
